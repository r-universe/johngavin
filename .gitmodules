[submodule ".registry"]
	path = .registry
	url = https://github.com/johngavin/johngavin.r-universe.dev
	branch = HEAD
[submodule "ForecastComb"]
	path = ForecastComb
	url = https://github.com/thierrymoudiki/ForecastComb
	registered = false
[submodule "ahead"]
	path = ahead
	url = https://github.com/Techtonique/ahead
	registered = false
[submodule "esgtoolkit"]
	path = esgtoolkit
	url = https://github.com/Techtonique/esgtoolkit
	registered = false
[submodule "etfdata"]
	path = etfdata
	url = https://github.com/JohnGavin/etf-data/tree/main/etfdata
[submodule "misc"]
	path = misc
	url = https://github.com/thierrymoudiki/misc
	registered = false
[submodule "randomwalk"]
	path = randomwalk
	url = https://github.com/JohnGavin/randomwalk
